# Copy this file to .env and fill in the values.
# .env is in .gitignore: it must never end up on GitHub.

# --- secrets -----------------------------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=
# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# --- models ------------------------------------------------------------------
# Check the current ids at https://console.groq.com/docs/models before changing
# these. Model names get retired; do not guess them.
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# A text model from the same page, e.g. one of the llama-3.x instruct ones.
TEXT_MODEL=

# --- everything else has a sensible default ----------------------------------
# Where audio, the database and backups live.
DATA_DIR=data
# The language spoken in the lessons, as a two-letter code. Whisper transcribes
# better when it is told rather than left to guess.
LANGUAGE=it
# Days to keep the audio files. The transcribed text is kept regardless.
AUDIO_RETENTION_DAYS=7
# Used to decide which calendar day a recording belongs to.
TIMEZONE=Europe/Rome
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- recording ---------------------------------------------------------------
# Which microphone `picatchup record` listens to. Raspberry Pi OS Lite should
# use alsa:auto when exactly one USB capture device is attached, or an explicit
# plughw:1,0 based on `arecord -l`. A desktop may use pulse:default.
AUDIO_INPUT_FORMAT=alsa
AUDIO_INPUT_DEVICE=auto
# Speech at 16 kHz mono. 48k gives about 20 MB per hour of lesson.
AUDIO_BITRATE=48k
# BCM numbering throughout. Disable GPIO/display for laptop development.
GPIO_ENABLED=true
# Button: BCM GPIO17 / physical pin 11 to GND, internal pull-up.
GPIO_BUTTON_PIN=17
# Red LED: BCM GPIO27 / physical pin 13 through a 330 ohm resistor to GND.
GPIO_LED_PIN=27

# SSD1306-compatible 128x64 OLED on I2C bus 1. No runtime bus scanning.
DISPLAY_ENABLED=true
OLED_I2C_ADDRESS=0x3C
OLED_WIDTH=128
OLED_HEIGHT=64

# Keep the newest N safe SQLite snapshots under DATA_DIR/backups.
BACKUP_RETENTION_COUNT=14
# Optional rsync-over-SSH directory. A Tailscale DNS name or 100.x address works.
# The remote directory must already exist. Leave empty for local-only backups.
# Example: backup@picatchup-nas.tailnet.ts.net:/volume1/backups/picatchup/
BACKUP_REMOTE=

# --- uploads -----------------------------------------------------------------
# Anything bigger than this gets cut into pieces before being sent to Whisper.
# Groq's own limit depends on your plan; staying under it is on us.
MAX_UPLOAD_MB=20
SEGMENT_MINUTES=10
