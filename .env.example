# Copy this file to .env and fill in the values.
# .env is in .gitignore: it must never end up on GitHub.

# --- secrets -----------------------------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=
# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# --- models ------------------------------------------------------------------
# Check the current ids at https://console.groq.com/docs/models before changing
# these. Model names get retired; do not guess them.
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
TEXT_MODEL=

# --- everything else has a sensible default ----------------------------------
# Where audio, the database and backups live.
DATA_DIR=data
# Days to keep the audio files. The transcribed text is kept regardless.
AUDIO_RETENTION_DAYS=7
# Used to decide which calendar day a recording belongs to.
TIMEZONE=Europe/Rome
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
