[Unit]
Description=PiCatchUp safe SQLite backup
Wants=network-online.target
After=local-fs.target network-online.target tailscaled.service

[Service]
Type=oneshot
User=picatchup
Group=picatchup
WorkingDirectory=/var/lib/picatchup
EnvironmentFile=/etc/picatchup/picatchup.env
ExecStart=/opt/picatchup/venv/bin/picatchup backup
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/picatchup
